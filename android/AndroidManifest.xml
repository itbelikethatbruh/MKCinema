<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mkcinema.app" android:versionCode="21" android:versionName="1.9.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 1.5.0 new-episode notifications: post them (Android 13+ asks), and keep the twice-daily check after a reboot -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 1.6.0: Continue watching row on the Android TV home screen (Watch Next) -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"/>
    <!-- Android TV, Google TV and Fire TV: no touchscreen or microphone needed. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.faketouch" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <queries>
        <package android:name="com.amazon.firetv.youtube"/>
        <package android:name="com.google.android.youtube.tv"/>
        <package android:name="com.google.android.youtube.googletv"/>
        <package android:name="com.google.android.youtube"/>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:mimeType="video/*"/></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH"/></intent>
        <intent><action android:name="android.speech.RecognitionService"/></intent>
    </queries>
    <!-- Launcher art (1.2.1): plain PNGs in drawable-* folders at every density, no adaptive XML icon and no mipmap.
         Fire OS's launcher reloads sideloaded apps' tiles from the image file the icon points to, and it can't read an
         adaptive-icon XML or a mipmap folder, so the tile turned into a grey broken image some time after install. -->
    <!-- 1.2.7: on TVs (UI mode television) the launcher icon resolves to drawable-television-*/ic_launcher.png, a SQUARE
         monogram-and-wordmark tile. Fire OS draws sideloaded apps' icons in a square box on a grey tile; the 16:9 banner
         used from 1.2.3 was squeezed into that square. The 16:9 banner stays as android:banner for Android TV / Google TV. -->
    <application android:label="MKCinema" android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner" android:theme="@style/Noir" android:hardwareAccelerated="true" android:allowBackup="false" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config" android:extractNativeLibs="true" android:largeHeap="true">
        <activity android:name=".MainActivity" android:exported="true" android:icon="@drawable/ic_launcher" android:banner="@drawable/banner" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:supportsPictureInPicture="true" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="mkcinema.pages.dev"/>
                <!-- 1.8.1: the web app's public home (shared links), opened on mkcinema.pages.dev where the sign-in lives -->
                <data android:scheme="https" android:host="app.mkcinema.app"/>
            </intent-filter>
            <!-- 1.8.1: mkcinema.app's front page only (its /download links keep opening in the browser) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="mkcinema.app" android:path="/"/>
            </intent-filter>
            <!-- 1.2.8: an addon setup page's Install button (stremio://...manifest.json) opens MKCinema, which asks before installing -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stremio"/>
            </intent-filter>
        </activity>
        <!-- 1.2.5: the TV player (system hardware decoder), opened from the page with MKAndroid.play -->
        <activity android:name=".PlayerActivity" android:exported="false" android:theme="@style/Noir"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"/>
        <!-- 1.5.0: twice-daily check for new episodes of the series you follow (no server; see EpisodeAlerts.java) -->
        <service android:name=".DlService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <!-- 1.8.1: the checked update APK, handed to the system installer (see UpdateFiles.java) -->
        <provider android:name=".UpdateFiles" android:authorities="com.mkcinema.app.update" android:exported="false" android:grantUriPermissions="true"/>
        <service android:name=".EpisodeAlerts" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>
    </application>
</manifest>
